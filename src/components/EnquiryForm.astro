---
import { localePath, withBase, type Locale } from "../data/site";
import { SERVICE_SLUGS, ui, type ServiceKey } from "../data/ui";

type Props = {
  locale: Locale;
  preselect?: ServiceKey | null;
};

const { locale, preselect = null } = Astro.props;
const t = ui(locale);
const termsHref = localePath(locale, "/legal/terms");
const enquiryAction = withBase("/api/enquiry");

const countries = [
  "Taiwan",
  "Japan",
  "Vietnam",
  "United States",
  "China",
  "Hong Kong",
  "Singapore",
  "South Korea",
  "Malaysia",
  "Thailand",
  "Philippines",
  "Indonesia",
  "Australia",
  "Germany",
  "United Kingdom",
  "Other"
];

const serviceKeys = Object.keys(SERVICE_SLUGS) as ServiceKey[];
---

<section class="section" id="enquiry-form">
  <div class="wrap" style="max-width:720px;">
    <h2>{t.form.heading}</h2>
    <form class="form-grid" method="post" action={enquiryAction} data-enquiry-form>
      <input type="hidden" name="locale" value={locale} />
      <input type="text" name="website" value="" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;height:0;width:0;opacity:0;" />
      <div class="form-row two">
        <label class="field">
          <span class="label-text">{t.form.firstName} <span class="req">*</span></span>
          <input name="firstName" required autocomplete="given-name" />
        </label>
        <label class="field">
          <span class="label-text">{t.form.lastName} <span class="req">*</span></span>
          <input name="lastName" required autocomplete="family-name" />
        </label>
      </div>
      <label class="field">
        <span class="label-text">{t.form.company} <span class="req">*</span></span>
        <input name="company" required autocomplete="organization" />
      </label>
      <div class="form-row two">
        <label class="field">
          <span class="label-text">{t.form.email} <span class="req">*</span></span>
          <input type="email" name="email" required autocomplete="email" />
        </label>
        <label class="field">
          <span class="label-text">{t.form.phone} <span class="req">*</span></span>
          <input type="tel" name="phone" required autocomplete="tel" />
        </label>
      </div>
      <label class="field">
        <span class="label-text">{t.form.country} <span class="req">*</span></span>
        <select name="country" required>
          <option value="">{t.form.countryPlaceholder}</option>
          {countries.map((c) => <option value={c}>{c}</option>)}
        </select>
      </label>
      <fieldset style="border:0;padding:0;margin:0;">
        <legend style="font-weight:600;font-size:0.92rem;margin-bottom:0.45rem;">{t.form.services}</legend>
        <div class="checks">
          {
            serviceKeys.map((key) => (
              <label class="check">
                <input
                  type="checkbox"
                  name="services"
                  value={key}
                  checked={preselect === key}
                />
                <span>{t.services[key].name}</span>
              </label>
            ))
          }
          <label class="check">
            <input type="checkbox" name="services" value="other" />
            <span>{t.form.other}</span>
          </label>
        </div>
      </fieldset>
      <label class="field">
        <span class="label-text">{t.form.message} <span class="req">*</span></span>
        <textarea name="message" required placeholder={t.form.messagePlaceholder}></textarea>
      </label>
      <label class="check">
        <input type="checkbox" name="acceptTerms" value="yes" required />
        <span>
          {t.form.acceptTerms}
          {" "}
          <a href={termsHref}>{t.form.termsLink}</a>
          <span class="req">*</span>
        </span>
      </label>
      <button class="btn btn-solid" type="submit" data-submit>{t.form.submit}</button>
      <div class="form-status" role="status" data-status data-success={t.form.success} data-error={t.form.error} data-sending={t.form.sending}></div>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector("[data-enquiry-form]") as HTMLFormElement | null;
  if (form) {
    const params = new URLSearchParams(location.search);
    const service = params.get("service");
    if (service) {
      const box = form.querySelector(`input[name="services"][value="${CSS.escape(service)}"]`) as HTMLInputElement | null;
      if (box) box.checked = true;
    }

    const status = form.querySelector("[data-status]") as HTMLElement;
    const submit = form.querySelector("[data-submit]") as HTMLButtonElement;
    const successText = status.dataset.success || "";
    const errorText = status.dataset.error || "";
    const sendingText = status.dataset.sending || "";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      status.className = "form-status";
      status.textContent = sendingText;
      status.classList.add("is-success");
      submit.disabled = true;
      try {
        const body = new FormData(form);
        const res = await fetch(form.action, { method: "POST", body });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || "failed");
        status.textContent = successText;
        status.className = "form-status is-success";
        form.reset();
      } catch {
        status.textContent = errorText;
        status.className = "form-status is-error";
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>
