---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import { pageContent } from "../data/content";
import { ui } from "../data/ui";
import type { Locale } from "../data/site";

type Props = { locale: Locale };
const { locale } = Astro.props;
const c = pageContent(locale).project;
const t = ui(locale);
---

<BaseLayout locale={locale} title={c.title} description={c.description} path="/services/project-logistics">
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">{t.nav.services}</p>
      <h1>{c.heroTitle}</h1>
      <p class="lede">{c.heroLead}</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap prose">
      <h2>{c.introTitle}</h2>
      {c.intro.map((p) => <p>{p}</p>)}
    </div>
    <div class="wrap grid-2" style="margin-top:1.25rem;">
      {
        c.strengths.map((item) => (
          <article class="card">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))
      }
    </div>
  </section>
  <section class="section section-muted">
    <div class="wrap">
      <h2>{c.sectorsTitle}</h2>
      <div class="certs" style="margin-top:1rem;">
        {c.sectors.map((sector) => <span class="cert-pill">{sector}</span>)}
      </div>
      <div class="prose" style="margin-top:2rem;">
        <h3>{c.qualityTitle}</h3>
        <p>{c.qualityBody}</p>
      </div>
    </div>
  </section>
  <CtaBand locale={locale} title={c.ctaTitle} body={c.ctaBody} service="project" />
</BaseLayout>

