---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import { pageContent } from "../data/content";
import { ui } from "../data/ui";
import type { Locale } from "../data/site";

type Props = { locale: Locale };
const { locale } = Astro.props;
const c = pageContent(locale).shipping;
const t = ui(locale);
---

<BaseLayout locale={locale} title={c.title} description={c.description} path="/services/shipping-agency">
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">{t.nav.services}</p>
      <h1>{c.heroTitle}</h1>
      <p class="lede">{c.heroLead}</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap prose">
      <h2>{c.introTitle}</h2>
      {c.intro.map((p) => <p>{p}</p>)}
    </div>
  </section>
  <section class="section section-muted">
    <div class="wrap">
      <h2>{c.vesselsTitle}</h2>
      <div class="grid-2" style="margin-top:1rem;">
        {
          c.vessels.map((vessel) => (
            <article class="card">
              <h3>{vessel.title}</h3>
              <p>{vessel.body}</p>
            </article>
          ))
        }
      </div>
      <h2 style="margin-top:2rem;">{c.strengthsTitle}</h2>
      <div class="certs">
        {c.strengths.map((item) => <span class="cert-pill">{item}</span>)}
      </div>
    </div>
  </section>
  <CtaBand locale={locale} title={c.ctaTitle} body={c.ctaBody} service="shipping" />
</BaseLayout>

